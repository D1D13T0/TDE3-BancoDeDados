<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:m="clr-namespace:TDE3_BancoDeDados.Models"
             x:Class="TDE3_BancoDeDados.Views.ClientesPage"
             Title="Clientes">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="14" MaximumWidthRequest="760">

            <!-- Formulário -->
            <Border Style="{StaticResource Cartao}">
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Border Style="{StaticResource Avatar}">
                            <Label Text="👤" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                            <Label x:Name="LblModo" Text="Novo cliente" Style="{StaticResource Titulo}" />
                            <Label x:Name="LblDica" Text="Preencha os dados e toque em Salvar" Style="{StaticResource Suave}" />
                        </VerticalStackLayout>
                    </Grid>

                    <VerticalStackLayout>
                        <Label Text="Nome" Style="{StaticResource Rotulo}" />
                        <Border Style="{StaticResource Campo}">
                            <Entry x:Name="TxtNome" Placeholder="Ex: Maria Silva" MaxLength="50" />
                        </Border>
                    </VerticalStackLayout>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <VerticalStackLayout>
                            <Label Text="RG" Style="{StaticResource Rotulo}" />
                            <Border Style="{StaticResource Campo}">
                                <Entry x:Name="TxtRg" Placeholder="Somente números" Keyboard="Numeric" MaxLength="10" />
                            </Border>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1">
                            <Label Text="Telefone" Style="{StaticResource Rotulo}" />
                            <Border Style="{StaticResource Campo}">
                                <Entry x:Name="TxtTelefone" Placeholder="(41)99999-9999" Keyboard="Telephone" MaxLength="14" />
                            </Border>
                        </VerticalStackLayout>
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" Margin="0,4,0,0">
                        <Button x:Name="BtnSalvar" Text="Cadastrar cliente" Clicked="OnSalvarClicked" />
                        <Button Grid.Column="1" Text="Limpar" Style="{StaticResource BotaoSecundario}" Clicked="OnLimparClicked" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Busca -->
            <Border Style="{StaticResource Campo}"
                    BackgroundColor="{AppThemeBinding Light={StaticResource Cartao}, Dark={StaticResource CartaoDark}}">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                    <Label Text="🔍" VerticalOptions="Center" Margin="4,0,0,0" />
                    <Entry Grid.Column="1" x:Name="TxtBusca" Placeholder="Buscar cliente pelo nome" TextChanged="OnBuscaChanged" />
                </Grid>
            </Border>

            <Label x:Name="LblContagem" Text="Clientes cadastrados" Style="{StaticResource TituloSecao}" />

            <!-- Lista -->
            <VerticalStackLayout x:Name="Lista" Spacing="10">
                <BindableLayout.EmptyView>
                    <Border Style="{StaticResource Cartao}" Padding="24">
                        <Label Text="Nenhum cliente encontrado." Style="{StaticResource Suave}" HorizontalOptions="Center" />
                    </Border>
                </BindableLayout.EmptyView>
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="m:Cliente">
                        <Border Style="{StaticResource Cartao}" Padding="14">
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
                                <Border Style="{StaticResource Avatar}">
                                    <Label Text="{Binding Inicial}" Style="{StaticResource AvatarTexto}" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                    <Label Text="{Binding Nome}" Style="{StaticResource Negrito}" />
                                    <Label Text="{Binding RG, StringFormat='RG {0}'}" Style="{StaticResource Suave}" />
                                    <Label Text="{Binding Telefone}" Style="{StaticResource Suave}" />
                                </VerticalStackLayout>
                                <Button Grid.Column="2" Text="✏️" Style="{StaticResource BotaoIcone}" Clicked="OnEditarClicked" />
                                <Button Grid.Column="3" Text="🗑️" Style="{StaticResource BotaoIconePerigo}" Clicked="OnExcluirClicked" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
