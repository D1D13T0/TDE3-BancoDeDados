<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:m="clr-namespace:TDE3_BancoDeDados.Models"
             x:Class="TDE3_BancoDeDados.Views.ComprasPage"
             Title="Compras">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="14" MaximumWidthRequest="760">

            <Button Text="＋  Nova compra" HeightRequest="52" FontSize="15" Clicked="OnNovaClicked" />

            <Label x:Name="LblContagem" Text="Compras registradas" Style="{StaticResource TituloSecao}" />

            <VerticalStackLayout x:Name="Lista" Spacing="10">
                <BindableLayout.EmptyView>
                    <Border Style="{StaticResource Cartao}" Padding="24">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="🧾" FontSize="32" HorizontalOptions="Center" />
                            <Label Text="Nenhuma compra registrada ainda." Style="{StaticResource Suave}" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Border>
                </BindableLayout.EmptyView>
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="m:Compra">
                        <Border Style="{StaticResource Cartao}" Padding="14">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <Border Style="{StaticResource Avatar}" StrokeShape="RoundRectangle 12">
                                    <Label Text="{Binding CodigoCompra, StringFormat='#{0}'}" Style="{StaticResource AvatarTexto}" FontSize="14" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                    <Label Text="{Binding Cliente.Nome}" Style="{StaticResource Negrito}" />
                                    <Label Text="{Binding Resumo}" Style="{StaticResource Suave}" />
                                    <Label Text="{Binding ValorTotal, StringFormat='{0:C}'}" Style="{StaticResource Valor}" />
                                </VerticalStackLayout>
                                <HorizontalStackLayout Grid.Column="2" Spacing="8" VerticalOptions="Center">
                                    <Button Text="✏️" Style="{StaticResource BotaoIcone}" Clicked="OnAbrirClicked" />
                                    <Button Text="🗑️" Style="{StaticResource BotaoIconePerigo}" Clicked="OnExcluirClicked" />
                                </HorizontalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
