<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:m="clr-namespace:TDE3_BancoDeDados.Models"
             x:Class="TDE3_BancoDeDados.Views.ProdutosPage"
             Title="Produtos">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="14" MaximumWidthRequest="760">

            <!-- Formulário -->
            <Border Style="{StaticResource Cartao}">
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Border Style="{StaticResource Avatar}">
                            <Label Text="📦" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                            <Label x:Name="LblModo" Text="Novo produto" Style="{StaticResource Titulo}" />
                            <Label x:Name="LblDica" Text="Preencha os dados e toque em Salvar" Style="{StaticResource Suave}" />
                        </VerticalStackLayout>
                    </Grid>

                    <VerticalStackLayout>
                        <Label Text="Nome do produto" Style="{StaticResource Rotulo}" />
                        <Border Style="{StaticResource Campo}">
                            <Entry x:Name="TxtNome" Placeholder="Ex: Café 500g" MaxLength="50" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout>
                        <Label Text="Tipo" Style="{StaticResource Rotulo}" />
                        <Border Style="{StaticResource Campo}">
                            <Entry x:Name="TxtTipo" Placeholder="Ex: Mercearia, Limpeza, Bebida" MaxLength="50" />
                        </Border>
                    </VerticalStackLayout>

                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <VerticalStackLayout>
                            <Label Text="Preço (R$)" Style="{StaticResource Rotulo}" />
                            <Border Style="{StaticResource Campo}">
                                <Entry x:Name="TxtPreco" Placeholder="0,00" Keyboard="Numeric" />
                            </Border>
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1">
                            <Label Text="Qtd. em estoque" Style="{StaticResource Rotulo}" />
                            <Border Style="{StaticResource Campo}">
                                <Entry x:Name="TxtEstoque" Placeholder="0" Keyboard="Numeric" />
                            </Border>
                        </VerticalStackLayout>
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" Margin="0,4,0,0">
                        <Button x:Name="BtnSalvar" Text="Cadastrar produto" Clicked="OnSalvarClicked" />
                        <Button Grid.Column="1" Text="Limpar" Style="{StaticResource BotaoSecundario}" Clicked="OnLimparClicked" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Busca -->
            <Border Style="{StaticResource Campo}"
                    BackgroundColor="{AppThemeBinding Light={StaticResource Cartao}, Dark={StaticResource CartaoDark}}">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                    <Label Text="🔍" VerticalOptions="Center" Margin="4,0,0,0" />
                    <Entry Grid.Column="1" x:Name="TxtBusca" Placeholder="Buscar por nome ou tipo" TextChanged="OnBuscaChanged" />
                </Grid>
            </Border>

            <Label x:Name="LblContagem" Text="Produtos cadastrados" Style="{StaticResource TituloSecao}" />

            <!-- Lista -->
            <VerticalStackLayout x:Name="Lista" Spacing="10">
                <BindableLayout.EmptyView>
                    <Border Style="{StaticResource Cartao}" Padding="24">
                        <Label Text="Nenhum produto encontrado." Style="{StaticResource Suave}" HorizontalOptions="Center" />
                    </Border>
                </BindableLayout.EmptyView>
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="m:Produto">
                        <Border Style="{StaticResource Cartao}" Padding="14">
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
                                <Border Style="{StaticResource Avatar}">
                                    <Label Text="📦" FontSize="18" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                    <Label Text="{Binding NomeProduto}" Style="{StaticResource Negrito}" />
                                    <Label Style="{StaticResource Suave}">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="{Binding Tipo}" />
                                                <Span Text="  ·  " />
                                                <Span Text="{Binding QtdEstoque, StringFormat='{0} em estoque'}" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                    <Label Text="{Binding Preco, StringFormat='{0:C}'}" Style="{StaticResource Valor}" />
                                </VerticalStackLayout>
                                <Button Grid.Column="2" Text="✏️" Style="{StaticResource BotaoIcone}" Clicked="OnEditarClicked" />
                                <Button Grid.Column="3" Text="🗑️" Style="{StaticResource BotaoIconePerigo}" Clicked="OnExcluirClicked" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
