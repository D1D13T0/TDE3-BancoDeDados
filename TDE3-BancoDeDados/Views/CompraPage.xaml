<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:m="clr-namespace:TDE3_BancoDeDados.Models"
             x:Class="TDE3_BancoDeDados.Views.CompraPage"
             Title="Compra">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="14" MaximumWidthRequest="760">

            <!-- Dados da compra -->
            <Border Style="{StaticResource Cartao}">
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Border Style="{StaticResource Avatar}">
                            <Label Text="🧾" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                            <Label x:Name="LblCompra" Text="Nova compra" Style="{StaticResource Titulo}" />
                            <Label x:Name="LblStatus" Text="Escolha o cliente e a data e salve a compra" Style="{StaticResource Suave}" />
                        </VerticalStackLayout>
                    </Grid>

                    <VerticalStackLayout>
                        <Label Text="Cliente" Style="{StaticResource Rotulo}" />
                        <Border Style="{StaticResource Campo}">
                            <Picker x:Name="PckCliente" Title="Selecione o cliente" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout>
                        <Label Text="Data da compra" Style="{StaticResource Rotulo}" />
                        <Border Style="{StaticResource Campo}">
                            <DatePicker x:Name="DtpData" Format="dd/MM/yyyy" />
                        </Border>
                    </VerticalStackLayout>

                    <Border StrokeThickness="0" StrokeShape="RoundRectangle 10" Padding="14,10"
                            BackgroundColor="{AppThemeBinding Light={StaticResource PrimarioSuave}, Dark={StaticResource PrimarioSuaveDark}}">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Valor total" Style="{StaticResource Suave}" VerticalOptions="Center" />
                            <Label Grid.Column="1" x:Name="LblTotal" Text="R$ 0,00" Style="{StaticResource Numero}" FontSize="22" />
                        </Grid>
                    </Border>

                    <Button x:Name="BtnSalvarCompra" Text="Salvar compra" Clicked="OnSalvarCompraClicked" />
                </VerticalStackLayout>
            </Border>

            <!-- Inclusão / edição de item -->
            <Border Style="{StaticResource Cartao}" x:Name="PainelItem" IsEnabled="False" Opacity="0.5">
                <VerticalStackLayout Spacing="12">
                    <Label x:Name="LblItem" Text="Adicionar item" Style="{StaticResource Titulo}" FontSize="17" />

                    <VerticalStackLayout>
                        <Label Text="Produto" Style="{StaticResource Rotulo}" />
                        <Border Style="{StaticResource Campo}">
                            <Picker x:Name="PckProduto" Title="Selecione o produto" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout>
                        <Label Text="Quantidade" Style="{StaticResource Rotulo}" />
                        <Border Style="{StaticResource Campo}">
                            <Entry x:Name="TxtQuantidade" Placeholder="Ex: 2" Keyboard="Numeric" />
                        </Border>
                    </VerticalStackLayout>

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <Button x:Name="BtnSalvarItem" Text="Adicionar item" Clicked="OnSalvarItemClicked" />
                        <Button Grid.Column="1" Text="Cancelar" Style="{StaticResource BotaoSecundario}" Clicked="OnCancelarItemClicked" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Label x:Name="LblContagemItens" Text="Itens da compra" Style="{StaticResource TituloSecao}" />

            <!-- Itens da compra -->
            <VerticalStackLayout x:Name="ListaItens" Spacing="10">
                <BindableLayout.EmptyView>
                    <Border Style="{StaticResource Cartao}" Padding="24">
                        <Label Text="Nenhum item adicionado." Style="{StaticResource Suave}" HorizontalOptions="Center" />
                    </Border>
                </BindableLayout.EmptyView>
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="m:ItemCompra">
                        <Border Style="{StaticResource Cartao}" Padding="14">
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
                                <Border Style="{StaticResource Avatar}">
                                    <Label Text="📦" FontSize="18" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                    <Label Text="{Binding Produto.NomeProduto}" Style="{StaticResource Negrito}" />
                                    <Label Text="{Binding Detalhe}" Style="{StaticResource Suave}" />
                                    <Label Text="{Binding ValorParcial, StringFormat='{0:C}'}" Style="{StaticResource Valor}" />
                                </VerticalStackLayout>
                                <Button Grid.Column="2" Text="✏️" Style="{StaticResource BotaoIcone}" Clicked="OnEditarItemClicked" />
                                <Button Grid.Column="3" Text="🗑️" Style="{StaticResource BotaoIconePerigo}" Clicked="OnExcluirItemClicked" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
